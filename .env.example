# 阿里百炼 API Key（必填）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 阿里百炼模型（可选，默认 qwen-plus）
# DASHSCOPE_MODEL=qwen-plus

# Azure DevOps PAT Token（analyze_pr 需要）
AZURE_DEVOPS_PAT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dify 知识库 API Key（search_kb 需要）
DIFY_API_KEY=dataset-xxxxxxxxxxxxxxxx

# Dify 服务地址（可选）
# DIFY_BASE_URL=https://dify-test.uat.autobestdevops.com

# 服务端口（可选，默认 8800）
# PORT=8800
# HOST=127.0.0.1